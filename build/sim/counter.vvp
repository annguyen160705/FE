#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x619fc5df87b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x619fc5df8940 .scope module, "tb_counter" "tb_counter" 3 4;
 .timescale -9 -12;
v0x619fc5e15fa0_0 .var "clk", 0 0;
v0x619fc5e16040_0 .net "count", 3 0, L_0x619fc5de7240;  1 drivers
v0x619fc5e160e0_0 .var "expected_count", 3 0;
v0x619fc5e161b0_0 .var/i "i", 31 0;
v0x619fc5e16290_0 .var "rst", 0 0;
E_0x619fc5df8fd0 .event posedge, v0x619fc5de7800_0;
E_0x619fc5df8e20 .event negedge, v0x619fc5de7800_0;
S_0x619fc5dbe500 .scope module, "dut" "counter" 3 15, 4 4 0, S_0x619fc5df8940;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 4 "count";
L_0x619fc5de7240 .functor BUFZ 4, v0x619fc5e15da0_0, C4<0000>, C4<0000>, C4<0000>;
v0x619fc5de7800_0 .net "clk", 0 0, v0x619fc5e15fa0_0;  1 drivers
v0x619fc5e15cc0_0 .net "count", 3 0, L_0x619fc5de7240;  alias, 1 drivers
v0x619fc5e15da0_0 .var "count_reg", 3 0;
v0x619fc5e15e60_0 .net "rst", 0 0, v0x619fc5e16290_0;  1 drivers
E_0x619fc5df9350 .event posedge, v0x619fc5e15e60_0, v0x619fc5de7800_0;
    .scope S_0x619fc5dbe500;
T_0 ;
    %wait E_0x619fc5df9350;
    %load/vec4 v0x619fc5e15e60_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x619fc5e15da0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x619fc5e15da0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x619fc5e15da0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x619fc5df8940;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x619fc5e15fa0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x619fc5df8940;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x619fc5e15fa0_0;
    %inv;
    %store/vec4 v0x619fc5e15fa0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x619fc5df8940;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x619fc5e16290_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x619fc5e160e0_0, 0, 4;
    %vpi_call/w 3 31 "$dumpfile", "build/waves/counter.vcd" {0 0 0};
    %vpi_call/w 3 32 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x619fc5df8940 {0 0 0};
    %vpi_call/w 3 34 "$display", "===== START SIMULATION =====" {0 0 0};
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x619fc5e16290_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x619fc5e16040_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 41 "$fatal", 32'sb00000000000000000000000000000001, "TC1 FAIL: Reset" {0 0 0};
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 43 "$display", "TC1 PASS: Reset" {0 0 0};
T_3.1 ;
    %wait E_0x619fc5df8e20;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x619fc5e16290_0, 0, 1;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x619fc5e161b0_0, 0, 32;
T_3.2 ;
    %load/vec4 v0x619fc5e161b0_0;
    %cmpi/s 16, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz T_3.3, 5;
    %wait E_0x619fc5df8fd0;
    %delay 1000, 0;
    %load/vec4 v0x619fc5e160e0_0;
    %addi 1, 0, 4;
    %store/vec4 v0x619fc5e160e0_0, 0, 4;
    %load/vec4 v0x619fc5e16040_0;
    %load/vec4 v0x619fc5e160e0_0;
    %cmp/ne;
    %jmp/0xz  T_3.4, 6;
    %vpi_call/w 3 57 "$fatal", 32'sb00000000000000000000000000000001, "FAIL: Expected=%0d, Got=%0d", v0x619fc5e160e0_0, v0x619fc5e16040_0 {0 0 0};
T_3.4 ;
    %vpi_call/w 3 62 "$display", "Time=%0t | Count=%0d | Expected=%0d", $time, v0x619fc5e16040_0, v0x619fc5e160e0_0 {0 0 0};
    %load/vec4 v0x619fc5e161b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x619fc5e161b0_0, 0, 32;
    %jmp T_3.2;
T_3.3 ;
    %vpi_call/w 3 68 "$display", "TC2 PASS: Counting" {0 0 0};
    %vpi_call/w 3 69 "$display", "TC3 PASS: Overflow" {0 0 0};
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x619fc5e16290_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x619fc5e16040_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_3.6, 6;
    %vpi_call/w 3 76 "$fatal", 32'sb00000000000000000000000000000001, "TC4 FAIL: Async Reset" {0 0 0};
    %jmp T_3.7;
T_3.6 ;
    %vpi_call/w 3 78 "$display", "TC4 PASS: Async Reset" {0 0 0};
T_3.7 ;
    %wait E_0x619fc5df8e20;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x619fc5e16290_0, 0, 1;
    %wait E_0x619fc5df8fd0;
    %delay 1000, 0;
    %load/vec4 v0x619fc5e16040_0;
    %cmpi/ne 1, 0, 4;
    %jmp/0xz  T_3.8, 6;
    %vpi_call/w 3 88 "$fatal", 32'sb00000000000000000000000000000001, "TC5 FAIL: Count after Reset" {0 0 0};
    %jmp T_3.9;
T_3.8 ;
    %vpi_call/w 3 90 "$display", "TC5 PASS: Count after Reset" {0 0 0};
T_3.9 ;
    %vpi_call/w 3 92 "$display", "============================" {0 0 0};
    %vpi_call/w 3 93 "$display", "ALL TESTS PASSED" {0 0 0};
    %vpi_call/w 3 94 "$display", "============================" {0 0 0};
    %vpi_call/w 3 96 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_counter.sv";
    "rtl/counter.sv";
