    puts "=========================================="
    read_liberty -corner $corner $corner_libs($corner)
    puts "\nSetup Timing:"
    report_checks -corner $corner -path_delay max -path_count 5
    puts "\nHold Timing:"
    report_checks -corner $corner -path_delay min -path_count 5
}
define_corners ss tt ff
exit
